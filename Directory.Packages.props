<!--
# 📄 Dosya Yolu: /Directory.Packages.props
# 📌 Amac: NuGet paket surumlerini merkezi olarak yonetir
# 📌 Modul - XML
# Version: 0.1.0
# Aciklama: Kaynak projelerde inline paket surumu kullanilmasini engeller

Bagimli Oldugu Katman: Tool
-->
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
