<!--
# 📄 Dosya Yolu: /Directory.Build.props
# 📌 Amac: Tum .NET projeleri icin ortak derleme, kalite ve urun surumu kurallarini merkezilestirir
# 📌 Modul - XML
# Version: 1.0.0
# Aciklama: Stable Community release adayi icin deterministik build ve ortak 1.0.0 surumunu uygular

Bagimli Oldugu Katman: Tool | Config
-->
<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Version>1.0.0</Version>
  </PropertyGroup>
</Project>
