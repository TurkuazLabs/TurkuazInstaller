<!--
Dosya Yolu: src/TurkuazInstaller.WinUI/themes/StandardHighContrast.xaml
Amac: Windows yuksek karsitlikta sistem renklerine oncelik veren tema
Modul - ResourceDictionary XAML
Version: 1.0.0
Aciklama: Sistem renklerini zorunlu kullanir, kurulum mantigina dokunmaz
Bagimli Oldugu Katman: View | Theme
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="TurkuazInstallerBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
    <SolidColorBrush x:Key="TurkuazInstallerHeroBrush" Color="{ThemeResource SystemColorWindowColor}" />
    <SolidColorBrush x:Key="TurkuazInstallerPanelBrush" Color="{ThemeResource SystemColorWindowColor}" />
    <SolidColorBrush x:Key="TurkuazInstallerAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
    <SolidColorBrush x:Key="TurkuazInstallerHeadingBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
    <SolidColorBrush x:Key="TurkuazInstallerMutedTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
</ResourceDictionary>
