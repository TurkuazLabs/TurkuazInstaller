Bagimli Oldugu Katman: View | Controller | Language
-->
<Window
    x:Class="TurkuazInstaller.WinUI.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid
        x:Name="MainRoot"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <ScrollViewer>
            <Grid
                Padding="32"
                RowSpacing="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    Spacing="6">
                    <TextBlock
                        Text="{Binding HeaderTitle}"
                        FontSize="32"
                        FontWeight="SemiBold" />
                    <TextBlock
                        Text="{Binding HeaderSubtitle}"
                        FontSize="15"
                        Opacity="0.72" />
                </StackPanel>

                <Border
                    Grid.Row="1"
                    Padding="24"
                    CornerRadius="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid
                            Grid.Row="0"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel
                                Grid.Column="0"
                                Spacing="2">
                                <TextBlock
                                    Text="{Binding InstalledAppsTitle}"
                                    FontSize="18"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Text="{Binding InstalledAppsCountText}"
                                    Opacity="0.65" />
                            </StackPanel>

                            <Button
                                Grid.Column="1"
                                Content="{Binding RefreshInstalledAppsLabel}"
                                IsEnabled="{Binding CanRun}"
                                VerticalAlignment="Center"
                                Click="RefreshInstalledApps_Click" />
                        </Grid>

                        <ListView
                            Grid.Row="1"
                            ItemsSource="{Binding InstalledApps}"
                            SelectionMode="None"
                            MaxHeight="240">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        Padding="4,8"
                                        ColumnSpacing="18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="3*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel
                                            Grid.Column="0"
                                            Spacing="3">
                                            <TextBlock
                                                Text="{Binding PackageId}"
                                                FontWeight="SemiBold" />
                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="10">
                                                <TextBlock
                                                    Text="{Binding Version}"
                                                    Opacity="0.72" />
                                                <TextBlock
                                                    Text="{Binding Channel}"
                                                    Opacity="0.72" />
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding TargetPath}"
                                            TextWrapping="Wrap"
                                            VerticalAlignment="Center"
                                            Opacity="0.72" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <InfoBar
                            Grid.Row="2"
                            IsOpen="{Binding HasCatalogError}"
                            Severity="Warning"
                            Message="{Binding CatalogErrorMessage}" />
                    </Grid>
                </Border>

                <Grid
                    Grid.Row="2"
                    Margin="0,8,0,0"
                    ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Padding="24"
                        CornerRadius="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="14">
                            <TextBlock
                                Text="{Binding SourceTitle}"
                                FontSize="18"
                                FontWeight="SemiBold" />

                            <TextBox
                                Header="{Binding PackageIdLabel}"
                                Text="{Binding PackageIdText, Mode=TwoWay}" />

                            <ComboBox
                                Header="{Binding ChannelLabel}"
                                ItemsSource="{Binding ChannelOptions}"
                                SelectedIndex="{Binding SelectedChannelIndex, Mode=TwoWay}" />

                            <TextBox
                                Header="{Binding ManifestSourceLabel}"
                                Text="{Binding ManifestSource, Mode=TwoWay}"
                                PlaceholderText="{Binding ManifestPlaceholder}" />

                            <TextBox
                                Header="{Binding RollbackManifestSourceLabel}"
                                Text="{Binding RollbackManifestSource, Mode=TwoWay}"
                                PlaceholderText="{Binding RollbackManifestPlaceholder}" />

                            <TextBox
                                Header="{Binding TargetPathLabel}"
                                Text="{Binding TargetPath, Mode=TwoWay}"
                                PlaceholderText="{Binding TargetPathPlaceholder}" />
                        </StackPanel>
                    </Border>

                    <StackPanel
                        Grid.Column="1"
                        Spacing="20">
                        <Border
                            Padding="24"
                            CornerRadius="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="12">
                                <TextBlock
                                    Text="{Binding OperationsTitle}"
                                    FontSize="18"
                                    FontWeight="SemiBold" />

                                <Button
                                    Content="{Binding InstallLabel}"
                                    IsEnabled="{Binding CanRun}"
                                    HorizontalAlignment="Stretch"
                                    Click="Install_Click" />
                                <Button
                                    Content="{Binding UpdateLabel}"
                                    IsEnabled="{Binding CanRun}"
                                    HorizontalAlignment="Stretch"
                                    Click="Update_Click" />
                                <Button
                                    Content="{Binding RepairLabel}"
                                    IsEnabled="{Binding CanRun}"
                                    HorizontalAlignment="Stretch"
                                    Click="Repair_Click" />
                                <Button
                                    Content="{Binding RollbackLabel}"
                                    IsEnabled="{Binding CanRun}"
                                    HorizontalAlignment="Stretch"
                                    Click="Rollback_Click" />
                                <Button
                                    Content="{Binding UninstallLabel}"
                                    IsEnabled="{Binding CanRun}"
                                    HorizontalAlignment="Stretch"
                                    Click="Uninstall_Click" />
                            </StackPanel>
                        </Border>

                        <Border
                            Padding="24"
                            CornerRadius="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="12">
                                <TextBlock
                                    Text="{Binding UpdateDiscoveryTitle}"
                                    FontSize="18"
                                    FontWeight="SemiBold" />

                                <Button
                                    Content="{Binding CheckUpdatesLabel}"
                                    IsEnabled="{Binding CanCheckUpdate}"
                                    HorizontalAlignment="Stretch"
                                    Click="CheckUpdates_Click" />

                                <Grid
                                    ColumnSpacing="12"
                                    RowSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Spacing="2">
                                        <TextBlock
                                            Text="{Binding InstalledVersionLabel}"
                                            Opacity="0.65" />
                                        <TextBlock
                                            Text="{Binding InstalledVersionText}"
                                            FontWeight="SemiBold" />
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Spacing="2">
                                        <TextBlock
                                            Text="{Binding LatestVersionLabel}"
                                            Opacity="0.65" />
                                        <TextBlock
                                            Text="{Binding LatestVersionText}"
                                            FontWeight="SemiBold" />
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        Text="{Binding UpdateDiscoveryStatus}"
                                        TextWrapping="Wrap"
                                        FontWeight="SemiBold" />
                                </Grid>

                                <InfoBar
                                    IsOpen="{Binding HasUpdateDiscoveryError}"
                                    Severity="Error"
                                    Message="{Binding UpdateDiscoveryErrorMessage}" />

                                <Separator />

                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Text="{Binding BackgroundUpdatesTitle}"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="{Binding BackgroundUpdateStatus}"
                                        TextWrapping="Wrap"
                                        Opacity="0.72" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border
                            Padding="24"
                            CornerRadius="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="12">
                                <TextBlock
                                    Text="{Binding StatusTitle}"
                                    FontSize="18"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Text="{Binding StatusMessage}"
                                    TextWrapping="Wrap" />
                                <ProgressBar
                                    Minimum="0"
                                    Maximum="100"
                                    Value="{Binding ProgressValue}" />
                                <InfoBar
                                    IsOpen="{Binding HasError}"
                                    Severity="Error"
                                    Message="{Binding ErrorMessage}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Padding="24"
                            CornerRadius="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="10">
                                <TextBlock
                                    Text="{Binding RecoveryTitle}"
                                    FontSize="18"
                                    FontWeight="SemiBold" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        Grid.Column="0"
                                        Content="{Binding RetryLabel}"
                                        IsEnabled="{Binding CanRetry}"
                                        HorizontalAlignment="Stretch"
                                        Click="Retry_Click" />
                                    <Button
                                        Grid.Column="1"
                                        Content="{Binding CancelLabel}"
                                        IsEnabled="{Binding CanCancel}"
                                        HorizontalAlignment="Stretch"
                                        Click="Cancel_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <TextBlock
                    Grid.Row="3"
                    Text="{Binding FooterLabel}"
                    HorizontalAlignment="Right"
                    Opacity="0.55" />
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
