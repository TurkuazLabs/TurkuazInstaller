<!--
# 📄 Dosya Yolu: /src/TurkuazInstaller.WinUI/views/MainWindow.xaml
# 📌 Amac: TurkuazInstaller ana WinUI 3 masaustu arayuzunu render eder
# 📌 Modul - View XAML
# Version: 1.7.0
# Aciklama: Kurulu uygulama katalogu, read-only update discovery, installer operations, progress ve recovery UX'ini tek pencerede sunar

Bagimli Oldugu Katman: View | Controller | Language
-->
<Window
    x:Class="TurkuazInstaller.WinUI.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid
        x:Name="MainRoot"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Render only cryptographically verified in-memory image resources. -->
        <Image
            Grid.RowSpan="2"
            x:Name="VerifiedThemeBackdrop"
            Visibility="Collapsed"
            IsHitTestVisible="False"
            Opacity="0.96"
            Stretch="UniformToFill" />
        <Border
            Grid.RowSpan="2"
            x:Name="VerifiedThemeContrastShade"
            Visibility="Collapsed"
            IsHitTestVisible="False"
            Background="#6B0C162A" />
        <!-- Appearance settings remain usable even while a required
             signed theme is being verified. UI-only settings do not
             affect publisher trust or installer operations. -->
        <Border
            Grid.Row="0"
            Margin="24,18,24,6"
            Padding="22,16"
            CornerRadius="20"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    CornerRadius="4"
                    Background="#0A9D96" />
                <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                    <TextBlock
                        Text="{Binding HeaderTitle}"
                        FontSize="29"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Text="{Binding HeaderSubtitle}"
                        FontSize="14"
                        TextWrapping="Wrap"
                        Opacity="0.78" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                    <ComboBox
                        x:Name="AppearanceModeSelector"
                        Header="Görünüm"
                        MinWidth="154"
                        SelectionChanged="AppearanceModeSelector_SelectionChanged"
                        AutomationProperties.Name="Görünüm modu">
                        <ComboBoxItem Content="Sistem" />
                        <ComboBoxItem Content="Açık" />
                        <ComboBoxItem Content="Koyu" />
                    </ComboBox>
                    <TextBlock
                        x:Name="AppearanceSaveWarning"
                        Text="Görünüm tercihi kaydedilemedi."
                        Foreground="#E88B32"
                        FontSize="11"
                        TextWrapping="Wrap"
                        MaxWidth="175"
                        Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" x:Name="MainContent">
            <Grid
                Padding="24,18,24,30"
                RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Padding="24"
                    CornerRadius="18"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid
                            Grid.Row="0"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel
                                Grid.Column="0"
                                Spacing="2">
                                <TextBlock
                                    Text="{Binding InstalledAppsTitle}"
                                    FontSize="18"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Text="{Binding InstalledAppsCountText}"
                                    Opacity="0.65" />
                            </StackPanel>

                            <Button
                                Grid.Column="1"
                                Content="{Binding RefreshInstalledAppsLabel}"
                                IsEnabled="{Binding CanRun}"
                                VerticalAlignment="Center"
                                Click="RefreshInstalledApps_Click" />
                        </Grid>

                        <ListView
                            Grid.Row="1"
                            ItemsSource="{Binding InstalledApps}"
                            SelectionMode="None"
                            MaxHeight="240">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        Padding="4,8"
                                        ColumnSpacing="18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="3*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel
                                            Grid.Column="0"
                                            Spacing="3">
                                            <TextBlock
                                                Text="{Binding PackageId}"
                                                FontWeight="SemiBold" />
                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="10">
                                                <TextBlock
                                                    Text="{Binding Version}"
                                                    Opacity="0.72" />
                                                <TextBlock
                                                    Text="{Binding Channel}"
                                                    Opacity="0.72" />
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding TargetPath}"
                                            TextWrapping="Wrap"
                                            VerticalAlignment="Center"
                                            Opacity="0.72" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <InfoBar
                            Grid.Row="2"
                            IsOpen="{Binding HasCatalogError}"
                            Severity="Warning"
                            Message="{Binding CatalogErrorMessage}" />
                    </Grid>
                </Border>

                <Grid
                    Grid.Row="1"
                    Margin="0,4,0,0"
                    ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Padding="24"
                        CornerRadius="18"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="14">
                            <TextBlock
                                Text="{Binding SourceTitle}"
                                FontSize="18"
                                FontWeight="SemiBold" />

                            <TextBox
                                x:Name="PackageIdEntry"
                                Header="{Binding PackageIdLabel}"
                                Text="{Binding PackageIdText, Mode=TwoWay}" />

                            <ComboBox
                                Header="{Binding ChannelLabel}"
                                ItemsSource="{Binding ChannelOptions}"
                                SelectedIndex="{Binding SelectedChannelIndex, Mode=TwoWay}" />

                            <TextBox
                                x:Name="ManifestSourceEntry"
                                Header="{Binding ManifestSourceLabel}"
                                Text="{Binding ManifestSource, Mode=TwoWay}"
                                PlaceholderText="{Binding ManifestPlaceholder}" />

                            <TextBox
                                Header="{Binding RollbackManifestSourceLabel}"
                                Text="{Binding RollbackManifestSource, Mode=TwoWay}"
                                PlaceholderText="{Binding RollbackManifestPlaceholder}" />

                            <TextBox
                                Header="{Binding TargetPathLabel}"
                                Text="{Binding TargetPath, Mode=TwoWay}"
                                PlaceholderText="{Binding TargetPathPlaceholder}" />
                        </StackPanel>
                    </Border>

                    <StackPanel
                        Grid.Column="1"
                        Spacing="20">
                        <Border
                            Padding="24"
                            CornerRadius="18"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="12">
                                <TextBlock
                                    Text="{Binding OperationsTitle}"
                                    FontSize="18"
                                    FontWeight="SemiBold" />

                                <Button
                                    Style="{StaticResource AccentButtonStyle}"
                                    Content="{Binding InstallLabel}"
                                    IsEnabled="{Binding CanRun}"
                                    HorizontalAlignment="Stretch"
                                    Click="Install_Click" />
                                <Button
                                    Content="{Binding UpdateLabel}"
                                    IsEnabled="{Binding CanRun}"
                                    HorizontalAlignment="Stretch"
                                    Click="Update_Click" />
                                <Button
                                    Content="{Binding RepairLabel}"
                                    IsEnabled="{Binding CanRun}"
                                    HorizontalAlignment="Stretch"
                                    Click="Repair_Click" />
                                <Button
                                    Content="{Binding RollbackLabel}"
                                    IsEnabled="{Binding CanRun}"
                                    HorizontalAlignment="Stretch"
                                    Click="Rollback_Click" />
                                <Button
                                    Content="{Binding UninstallLabel}"
                                    IsEnabled="{Binding CanRun}"
                                    HorizontalAlignment="Stretch"
                                    Click="Uninstall_Click" />
                            </StackPanel>
                        </Border>

                        <Border
                            Padding="24"
                            CornerRadius="18"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="12">
                                <TextBlock
                                    Text="{Binding UpdateDiscoveryTitle}"
                                    FontSize="18"
                                    FontWeight="SemiBold" />

                                <Button
                                    Content="{Binding CheckUpdatesLabel}"
                                    IsEnabled="{Binding CanCheckUpdate}"
                                    HorizontalAlignment="Stretch"
                                    Click="CheckUpdates_Click" />

                                <Grid
                                    ColumnSpacing="12"
                                    RowSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Spacing="2">
                                        <TextBlock
                                            Text="{Binding InstalledVersionLabel}"
                                            Opacity="0.65" />
                                        <TextBlock
                                            Text="{Binding InstalledVersionText}"
                                            FontWeight="SemiBold" />
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Spacing="2">
                                        <TextBlock
                                            Text="{Binding LatestVersionLabel}"
                                            Opacity="0.65" />
                                        <TextBlock
                                            Text="{Binding LatestVersionText}"
                                            FontWeight="SemiBold" />
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        Text="{Binding UpdateDiscoveryStatus}"
                                        TextWrapping="Wrap"
                                        FontWeight="SemiBold" />
                                </Grid>

                                <InfoBar
                                    IsOpen="{Binding HasUpdateDiscoveryError}"
                                    Severity="Error"
                                    Message="{Binding UpdateDiscoveryErrorMessage}" />

                                <Border
                                    Height="1"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Text="{Binding BackgroundUpdatesTitle}"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="{Binding BackgroundUpdateStatus}"
                                        TextWrapping="Wrap"
                                        Opacity="0.72" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border
                            Padding="24"
                            CornerRadius="18"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="12">
                                <TextBlock
                                    Text="{Binding StatusTitle}"
                                    FontSize="18"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Text="{Binding StatusMessage}"
                                    TextWrapping="Wrap" />
                                <ProgressBar
                                    Minimum="0"
                                    Maximum="100"
                                    Value="{Binding ProgressValue}" />
                                <InfoBar
                                    IsOpen="{Binding HasError}"
                                    Severity="Error"
                                    Message="{Binding ErrorMessage}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Padding="24"
                            CornerRadius="18"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="10">
                                <TextBlock
                                    Text="{Binding RecoveryTitle}"
                                    FontSize="18"
                                    FontWeight="SemiBold" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        Grid.Column="0"
                                        Content="{Binding RetryLabel}"
                                        IsEnabled="{Binding CanRetry}"
                                        HorizontalAlignment="Stretch"
                                        Click="Retry_Click" />
                                    <Button
                                        Grid.Column="1"
                                        Content="{Binding CancelLabel}"
                                        IsEnabled="{Binding CanCancel}"
                                        HorizontalAlignment="Stretch"
                                        Click="Cancel_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <TextBlock
                    Grid.Row="2"
                    Text="{Binding FooterLabel}"
                    HorizontalAlignment="Right"
                    Opacity="0.55" />
            </Grid>
        </ScrollViewer>
        <InfoBar
            Grid.Row="1"
            x:Name="ThemeVerificationFailure"
            IsOpen="False"
            IsClosable="False"
            Severity="Error"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Title="Tema dosyası doğrulanamadı"
            Message="Gerekli imzalı tema geçersiz ya da eksik. Kurulum işlemleri durduruldu." />
    </Grid>
</Window>
