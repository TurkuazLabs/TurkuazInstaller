<!--
# 📄 Dosya Yolu: /src/TurkuazInstaller.WinUI/views/MainWindow.xaml
# 📌 Amac: TurkuazInstaller WinUI yonetim panelini ve iki asamali kurulum sihirbazini render eder
# 📌 Modul - View XAML
# Version: 2.0.0
# Aciklama: Modern dashboard, kurulum asamalari, paket katalogu, imzali kaynak, ilerleme ve gercek islem butonlari
# Bagimli Oldugu Katman: View | Controller | Language
-->
<Window
    x:Class="TurkuazInstaller.WinUI.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tools="using:TurkuazInstaller.WinUI.Tools">
    <Grid x:Name="MainRoot" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <tools:BooleanVisibilityConverter x:Key="PromotionVisibilityConverter" />
        </Grid.Resources>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Padding="28" MaxWidth="1500" HorizontalAlignment="Stretch" RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand hero: actual installed count and runtime status, never a fake verified badge. -->
                <Border Grid.Row="0" CornerRadius="20" Padding="28,24">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#082B43" Offset="0" />
                            <GradientStop Color="#076B78" Offset="0.62" />
                            <GradientStop Color="#098EB0" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DashboardEyebrowLabel}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="#A5EEE8" CharacterSpacing="120" />
                            <TextBlock Text="{Binding HeaderTitle}" FontSize="34"
                                       FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="{Binding DashboardTaglineLabel}" FontSize="14"
                                       TextWrapping="Wrap" Foreground="#E1F3F7"
                                       MaxWidth="720" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="7"
                                    HorizontalAlignment="Right">
                            <TextBlock Text="{Binding InstalledAppsTitle}"
                                       Foreground="#BDE8EB" FontSize="12"
                                       HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding InstalledAppsCountText}"
                                       Foreground="White" FontSize="21"
                                       FontWeight="SemiBold" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding StatusMessage}"
                                       TextWrapping="Wrap" Foreground="#BDE8EB"
                                       FontSize="12" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Explanatory lifecycle stages; none claim CMS verification has already run. -->
                <Border Grid.Row="1" Padding="18,16" CornerRadius="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding OverviewTitleLabel}" FontSize="16"
                                   FontWeight="SemiBold" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                <Border Width="30" Height="30" CornerRadius="9" Background="#0A8499">
                                    <TextBlock Text="01" Foreground="White" FontWeight="SemiBold"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding WorkflowSourceLabel}"
                                           VerticalAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                <Border Width="30" Height="30" CornerRadius="9" Background="#314C65">
                                    <TextBlock Text="02" Foreground="White" FontWeight="SemiBold"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding WorkflowTrustLabel}"
                                           VerticalAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                                <Border Width="30" Height="30" CornerRadius="9" Background="#314C65">
                                    <TextBlock Text="03" Foreground="White" FontWeight="SemiBold"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding WorkflowInstallLabel}"
                                           VerticalAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10">
                                <Border Width="30" Height="30" CornerRadius="9" Background="#314C65">
                                    <TextBlock Text="04" Foreground="White" FontWeight="SemiBold"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding WorkflowMaintainLabel}"
                                           VerticalAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2" ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="18">
                        <Border CornerRadius="16" Padding="24"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding SourceSectionTitleLabel}"
                                               FontWeight="SemiBold" FontSize="21" />
                                    <TextBlock Text="{Binding HeaderSubtitle}"
                                               Opacity="0.68" FontSize="13" TextWrapping="Wrap" />
                                </StackPanel>

                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Header="{Binding PackageIdLabel}"
                                             Text="{Binding PackageIdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <ComboBox Grid.Column="1" MinWidth="110"
                                              Header="{Binding ChannelLabel}"
                                              ItemsSource="{Binding ChannelOptions}"
                                              SelectedIndex="{Binding SelectedChannelIndex, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch" />
                                </Grid>

                                <TextBox Header="{Binding ManifestSourceLabel}"
                                         Text="{Binding ManifestSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="{Binding ManifestPlaceholder}" />

                                <Expander Header="{Binding SourceAdvancedLabel}" IsExpanded="False">
                                    <StackPanel Spacing="12" Margin="4,10,4,14">
                                        <TextBox Header="{Binding RollbackManifestSourceLabel}"
                                                 Text="{Binding RollbackManifestSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="{Binding RollbackManifestPlaceholder}" />
                                        <TextBox Header="{Binding TargetPathLabel}"
                                                 Text="{Binding TargetPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="{Binding TargetPathPlaceholder}" />
                                    </StackPanel>
                                </Expander>

                                <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                                         Message="{Binding SourceSecurityDescriptionLabel}" />
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="16" Padding="24"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="{Binding InstalledAppsTitle}"
                                                   FontSize="19" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ManagedCatalogDescriptionLabel}"
                                                   Opacity="0.7" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="{Binding RefreshInstalledAppsLabel}"
                                            IsEnabled="{Binding CanRun}"
                                            VerticalAlignment="Center"
                                            Click="RefreshInstalledApps_Click" />
                                </Grid>
                                <TextBlock Text="{Binding InstalledAppsCountText}"
                                           FontWeight="SemiBold" Opacity="0.84" />
                                <TextBlock Text="{Binding InstalledAppsEmptyMessage}"
                                           TextWrapping="Wrap" Opacity="0.66"
                                           Visibility="{Binding IsCatalogEmpty, Converter={StaticResource PromotionVisibilityConverter}}" />
                                <ListView ItemsSource="{Binding InstalledApps}"
                                          Visibility="{Binding HasInstalledApps, Converter={StaticResource PromotionVisibilityConverter}}"
                                          SelectionMode="None" MaxHeight="270">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="4,9" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="3*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Spacing="3">
                                                    <TextBlock Text="{Binding PackageId}"
                                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                                        <TextBlock Text="{Binding Version}" Opacity="0.72" />
                                                        <TextBlock Text="{Binding Channel}" Opacity="0.72" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding TargetPath}"
                                                           VerticalAlignment="Center" TextWrapping="Wrap"
                                                           Opacity="0.72" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <InfoBar IsOpen="{Binding HasCatalogError}" Severity="Warning"
                                         Message="{Binding CatalogErrorMessage}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="18">
                        <Border CornerRadius="16" Padding="24"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="14">
                                <TextBlock Text="{Binding OperationsTitle}"
                                           FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding OperationsDescriptionLabel}"
                                           TextWrapping="Wrap" Opacity="0.7" />
                                <Button Content="{Binding InstallLabel}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        IsEnabled="{Binding CanInstall}"
                                        HorizontalAlignment="Stretch"
                                        MinHeight="44" Click="Install_Click" />
                                <Grid ColumnSpacing="10" RowSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Button Grid.Row="0" Grid.Column="0"
                                            Content="{Binding UpdateLabel}"
                                            IsEnabled="{Binding CanUpdate}"
                                            MinHeight="36" HorizontalAlignment="Stretch"
                                            Click="Update_Click" />
                                    <Button Grid.Row="0" Grid.Column="1"
                                            Content="{Binding RepairLabel}"
                                            IsEnabled="{Binding CanRepair}"
                                            MinHeight="36" HorizontalAlignment="Stretch"
                                            Click="Repair_Click" />
                                    <Button Grid.Row="1" Grid.Column="0"
                                            Content="{Binding RollbackLabel}"
                                            IsEnabled="{Binding CanRollback}"
                                            MinHeight="36" HorizontalAlignment="Stretch"
                                            Click="Rollback_Click" />
                                    <Button Grid.Row="1" Grid.Column="1"
                                            Content="{Binding UninstallLabel}"
                                            IsEnabled="{Binding CanUninstall}"
                                            MinHeight="36" HorizontalAlignment="Stretch"
                                            Click="Uninstall_Click" />
                                </Grid>
                                <TextBlock Text="{Binding ActionGuidanceMessage}"
                                           FontSize="12" TextWrapping="Wrap" Opacity="0.72" />
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="16" Padding="24"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="13">
                                <TextBlock Text="{Binding UpdateDiscoveryTitle}"
                                           FontSize="18" FontWeight="SemiBold" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="3">
                                        <TextBlock Text="{Binding InstalledVersionLabel}" Opacity="0.68" />
                                        <TextBlock Text="{Binding InstalledVersionText}"
                                                   FontWeight="SemiBold" FontSize="17" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="{Binding LatestVersionLabel}" Opacity="0.68" />
                                        <TextBlock Text="{Binding LatestVersionText}"
                                                   FontWeight="SemiBold" FontSize="17" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding UpdateDiscoveryStatus}"
                                           TextWrapping="Wrap" FontWeight="SemiBold" />
                                <Button Content="{Binding CheckUpdatesLabel}"
                                        IsEnabled="{Binding CanCheckUpdate}"
                                        HorizontalAlignment="Stretch" Click="CheckUpdates_Click" />
                                <InfoBar IsOpen="{Binding HasUpdateDiscoveryError}"
                                         Severity="Error" Message="{Binding UpdateDiscoveryErrorMessage}" />
                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <TextBlock Text="{Binding BackgroundUpdatesTitle}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding BackgroundUpdateStatus}"
                                           Opacity="0.72" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="16" Padding="24"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{Binding StatusTitle}"
                                           FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                                <ProgressBar Minimum="0" Maximum="100" Height="6"
                                             Value="{Binding ProgressValue}" />
                                <InfoBar IsOpen="{Binding HasError}"
                                         Severity="Error" Message="{Binding ErrorMessage}" />
                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <TextBlock Text="{Binding RecoveryTitle}" FontWeight="SemiBold" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="{Binding RetryLabel}"
                                            IsEnabled="{Binding CanRetry}"
                                            HorizontalAlignment="Stretch" Click="Retry_Click" />
                                    <Button Grid.Column="1" Content="{Binding CancelLabel}"
                                            IsEnabled="{Binding CanCancel}"
                                            HorizontalAlignment="Stretch" Click="Cancel_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Local-only product-neutral panel; no external tracking or advertising. -->
                        <Border x:Name="PromotionPanel"
                                Visibility="{Binding IsPromotionVisible, Converter={StaticResource PromotionVisibilityConverter}}"
                                Padding="20" CornerRadius="16"
                                BorderBrush="#226EDAD6" BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#0B2436" Offset="0" />
                                    <GradientStop Color="#095E62" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding PromotionEyebrow}" Foreground="#81F2E3"
                                           FontSize="11" FontWeight="SemiBold" CharacterSpacing="100" />
                                <TextBlock Text="{Binding PromotionTitle}" Foreground="White"
                                           FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding PromotionDescription}" Foreground="#D6E5EE"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding PromotionProvider}" Foreground="#A1BFCB"
                                           FontSize="11" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
                <TextBlock Grid.Row="3" Text="{Binding FooterLabel}"
                           HorizontalAlignment="Right" Opacity="0.55" />
            </Grid>
        </ScrollViewer>

        <!-- Wizard step 1: installation preferences; no payload mutation yet. -->
        <ContentDialog x:Name="InstallChoiceDialog"
                       Title="{Binding InstallOptionsTitle}"
                       PrimaryButtonText="{Binding WizardNextLabel}"
                       IsPrimaryButtonEnabled="{Binding CanContinueInstallWizard}"
                       CloseButtonText="{Binding CancelLabel}"
                       DefaultButton="Primary">
            <StackPanel Spacing="16" MinWidth="430" MaxWidth="560">
                <TextBlock Text="{Binding WizardNextLabel}"
                           FontWeight="SemiBold" Foreground="#0A8499" />
                <TextBlock Text="{Binding InstallOptionsDescription}"
                           TextWrapping="Wrap" Opacity="0.74" />
                <RadioButtons Header="{Binding InstallModeHeader}"
                              SelectedIndex="{Binding SelectedInstallModeIndex, Mode=TwoWay}">
                    <RadioButton Content="{Binding QuickInstallLabel}" />
                    <RadioButton Content="{Binding CustomInstallLabel}" />
                </RadioButtons>
                <RadioButtons Header="{Binding InstallScopeHeader}"
                              SelectedIndex="{Binding SelectedInstallScopeIndex, Mode=TwoWay}">
                    <RadioButton Content="{Binding PerUserInstallLabel}" />
                    <RadioButton Content="{Binding PerMachineUnavailableLabel}" IsEnabled="False" />
                </RadioButtons>
                <StackPanel Spacing="6"
                            Visibility="{Binding IsCustomInstall, Converter={StaticResource PromotionVisibilityConverter}}">
                    <TextBlock Text="{Binding CustomTargetHeader}" />
                    <TextBox Text="{Binding TargetPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="{Binding CustomTargetHeader}" />
                </StackPanel>
            </StackPanel>
        </ContentDialog>

        <!-- Wizard step 2: read-only review. The Service still does all signature checks. -->
        <ContentDialog x:Name="InstallReviewDialog"
                       Title="{Binding WizardReviewTitleLabel}"
                       PrimaryButtonText="{Binding InstallLabel}"
                       IsPrimaryButtonEnabled="{Binding CanContinueInstallWizard}"
                       CloseButtonText="{Binding WizardBackLabel}"
                       DefaultButton="Primary">
            <StackPanel Spacing="14" MinWidth="430" MaxWidth="560">
                <TextBlock Text="{Binding WizardReviewDescriptionLabel}"
                           TextWrapping="Wrap" Opacity="0.75" />
                <TextBlock Text="{Binding PackageIdLabel}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding PackageIdText}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ManifestSourceLabel}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ManifestSource}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding InstallModeHeader}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding WizardSelectedModeLabel}" />
                <TextBlock Text="{Binding TargetPathLabel}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding WizardTargetPreview}" TextWrapping="Wrap" />
                <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                         Message="{Binding WizardTrustNoticeLabel}" />
            </StackPanel>
        </ContentDialog>
    </Grid>
</Window>
