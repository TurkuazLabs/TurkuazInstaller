# 📌 Amac: TurkuazInstaller Windows CLI ve silent-mode executable projesini derler
# 📌 Modul - Project XML
# Version: 1.0.0
# Aciklama: GUI bagimliligi olmadan ayni Application, Repo ve Windows Tool katmanlarini kullanan console runtime'i uretir

Bagimli Oldugu Katman: Controller | Service | Repo | Tool | Config
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SelfContained>true</SelfContained>
    <RootNamespace>TurkuazInstaller.Cli</RootNamespace>
    <AssemblyName>TurkuazInstaller.Cli</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TurkuazInstaller.Application/TurkuazInstaller.Application.csproj" />
    <ProjectReference Include="../TurkuazInstaller.Contracts/TurkuazInstaller.Contracts.csproj" />
    <ProjectReference Include="../TurkuazInstaller.Domain/TurkuazInstaller.Domain.csproj" />
    <ProjectReference Include="../TurkuazInstaller.Infrastructure/TurkuazInstaller.Infrastructure.csproj" />
    <ProjectReference Include="../TurkuazInstaller.Platform.Windows/TurkuazInstaller.Platform.Windows.csproj" />
  </ItemGroup>
</Project>
