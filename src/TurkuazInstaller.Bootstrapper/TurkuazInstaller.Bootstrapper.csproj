<!--
# 📄 Dosya Yolu: /src/TurkuazInstaller.Bootstrapper/TurkuazInstaller.Bootstrapper.csproj
# 📌 Amac: TurkuazInstaller Windows NativeAOT bootstrap executable projesini tanimlar
# 📌 Modul - Project XML
# Version: 1.0.1
# Aciklama: Stable release NativeAOT binary'sini debug PDB olmadan ve reproducible Windows linker modu ile publish eder

Bagimli Oldugu Katman: Service | Tool | Config
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>TurkuazInstaller.Bootstrapper</RootNamespace>
    <AssemblyName>TurkuazInstaller.Bootstrapper</AssemblyName>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <LinkerArg Include="/Brepro" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../TurkuazInstaller.Application/TurkuazInstaller.Application.csproj" />
    <ProjectReference Include="../TurkuazInstaller.Contracts/TurkuazInstaller.Contracts.csproj" />
    <ProjectReference Include="../TurkuazInstaller.Platform.Windows/TurkuazInstaller.Platform.Windows.csproj" />
  </ItemGroup>
</Project>
